{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ichtus-leuven-local",
  "keep_vars": true,
  "compatibility_date": "2026-08-01",
  // global_fetch_strictly_public is load-bearing, not incidental: the image
  // optimizer fetches CMS uploads from this Worker's own public hostname, and
  // without the flag that request would bypass Workers and look for a zone
  // origin that does not exist. Removing it breaks every CMS image.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "local-ichtus-leuven",
      "database_name": "ichtus-leuven-local"
    }
  ],
  // The second bucket is the OpenNext incremental cache. It shares the media
  // bucket because the adapter namespaces every object under
  // `incremental-cache/<buildId>/`, while the Payload R2 storage adapter writes
  // media at the root by filename and never lists the bucket. The binding name
  // is fixed by the adapter and cannot be renamed. Keep the R2 binding first:
  // src/scripts/preflight.ts and src/scripts/pullRemoteContent.ts both read
  // r2_buckets[0] positionally.
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "ichtus-leuven-media-local" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "ichtus-leuven-media-local" }
  ],
  // Enables Next.js image optimization through Cloudflare Images.
  // Free plan: 5,000 unique transformations per month (see ADR 0006).
  "images": { "binding": "IMAGES" },
  "env": {
    "staging": {
      "name": "ichtus-leuven-staging",
      "workers_dev": true,
      "vars": { "APP_ENV": "staging" },
      "routes": [{ "pattern": "staging.ichtusleuven.be", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "1095fa5a-4e04-4149-ae5b-ef186612427c",
          "database_name": "ichtus-leuven-staging",
          "remote": true
        }
      ],
      "r2_buckets": [
        { "binding": "R2", "bucket_name": "ichtus-leuven-media-staging", "remote": true },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "ichtus-leuven-media-staging",
          "remote": true
        }
      ],
      "images": { "binding": "IMAGES" },
      "send_email": [{ "name": "EMAIL" }]
    },
    "production": {
      "name": "ichtus-leuven-production",
      "workers_dev": true,
      "vars": { "APP_ENV": "production" },
      "routes": [
        { "pattern": "ichtusleuven.be", "custom_domain": true },
        { "pattern": "www.ichtusleuven.be", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "ae38d5a8-aea9-480a-9534-c934224113de",
          "database_name": "ichtus-leuven-production",
          "remote": true
        }
      ],
      "r2_buckets": [
        { "binding": "R2", "bucket_name": "ichtus-leuven-media-production", "remote": true },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "ichtus-leuven-media-production",
          "remote": true
        }
      ],
      "images": { "binding": "IMAGES" },
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
