# Local defaults. Deployment values live in isolated GitHub staging/production environments.
# Generate at least 32 random characters, for example: openssl rand -hex 32
PAYLOAD_SECRET=
FIRST_USER_SETUP_SECRET=
FIRST_USER_SETUP_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
CALENDAR_SYNC_SECRET=
PAYLOAD_JOBS_SECRET=
# Set only when intentionally using remote bindings during local commands.
CLOUDFLARE_REMOTE=false
# Optional isolated local Wrangler state, useful for CI and migration tests.
CLOUDFLARE_PERSIST_PATH=
EMAIL_FROM_ADDRESS=hello@example.com
EMAIL_FROM_NAME=Ichtus Leuven
EMAIL_REPLY_TO=leuven@ichtus.be
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Self-hosted OpenPanel. The client id is public; leave both blank locally to keep development out of the reporting.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_OPENPANEL_API_URL=https://analytics.zias.be/api
# Only required for server-side events, which the site does not send today.
OPENPANEL_CLIENT_SECRET=
REGISTRATION_CLEANUP_SECRET=
# 32 random bytes as hexadecimal, for example: openssl rand -hex 32
REGISTRATION_DELIVERY_KEY=
REGISTRATION_DELIVERY_SECRET=
# Human-readable declarations checked by preflight. Configure the actual authenticated jobs separately.
REGISTRATION_DELIVERY_SCHEDULE=*/5 * * * *
REGISTRATION_CLEANUP_SCHEDULE=*/5 * * * *
CALENDAR_SYNC_SCHEDULE=0 * * * *
PAYLOAD_JOBS_SCHEDULE=* * * * *
# Optional until external uptime monitoring is provisioned.
MONITORING_HEALTHCHECK_URL=
# Set true only after the Internet Friends production license is recorded.
FONT_PRODUCTION_LICENSE_CONFIRMED=false
# Remote empty-database seeding requires this to exactly equal CLOUDFLARE_ENV. Never set for deploys.
SEED_EMPTY_DATABASE=
