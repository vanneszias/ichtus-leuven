{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Build output and lockfile
      "!pnpm-lock.yaml",
      "!.next",
      "!.open-next",
      "!.wrangler",
      "!playwright-report",
      "!test-results",
      // Static assets: standalone SVGs are otherwise linted with JSX a11y rules
      "!public",
      // Generated by wrangler/payload and diffed by the Quality workflow
      "!cloudflare-env.d.ts",
      "!src/payload-types.ts",
      "!src/payload-generated-schema.ts",
      "!src/seed/generated",
      "!src/migrations",
      "!src/app/(payload)/admin/importMap.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    // Replaces eslint-config-next's core-web-vitals and React rules
    "domains": { "next": "recommended", "react": "recommended", "test": "recommended" },
    "rules": {
      "preset": "recommended",
      // Carried over from the old ESLint severities
      "complexity": { "noBannedTypes": "warn" },
      "correctness": { "noUnusedVariables": "warn" },
      "suspicious": { "noExplicitAny": "warn", "noTsIgnore": "warn" }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
